# Contoh .env untuk SERVER PRODUKSI. Salin menjadi .env di server, lalu isi nilai yang bertanda <...>.
# Jangan pernah meng-commit .env asli (berisi rahasia).

APP_NAME="<Nama Situs>"
APP_ENV=production
APP_KEY=                    # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_db>
DB_USERNAME=<user_db>       # pakai user khusus aplikasi, bukan root
DB_PASSWORD=<password_kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database   # wajib ada queue worker (lihat docs/DEPLOYMENT.md)

# Sanctum: token API kedaluwarsa dalam menit (10080 = 7 hari). Lihat docs/DEPLOYMENT.md bagian Keamanan.
SANCTUM_EXPIRATION=10080

# Email transaksional (verifikasi, reset password, notifikasi)
MAIL_MAILER=smtp
MAIL_HOST=<smtp.host>
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans PRODUKSI
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=<Mid-server-...>
MIDTRANS_CLIENT_KEY=<Mid-client-...>
PAYMENT_FINISH_URL=https://<domain-anda>/pembayaran/selesai

# Google Maps (batasi key di Google Cloud Console)
GOOGLE_MAPS_SERVER_KEY=<key-server-geocoding>
GOOGLE_MAPS_BROWSER_KEY=<key-browser-maps-js>

# WebSocket (hanya bila klien lain memakai Reverb; web memakai polling)
BROADCAST_CONNECTION=reverb
